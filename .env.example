# Database Configuration
DB_HOST=localhost
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_PORT=5432

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro

# Processing Settings
BATCH_SIZE=8
MAX_FILE_WORKERS=3
MAX_RETRIES=3
TIMEOUT_SECONDS=120

# Logging
LOG_LEVEL=INFO
